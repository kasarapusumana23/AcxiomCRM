@model AcxiomCRM.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center">

        <h1>Customer Details</h1>

        <a asp-action="Index"
           class="btn btn-secondary">
            Back to Customers
        </a>

    </div>

    <div class="card shadow-sm mt-4">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Name
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>

                <dt class="col-sm-3">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @Model.Email
                </dd>

                <dt class="col-sm-3">
                    Phone
                </dt>

                <dd class="col-sm-9">
                    @Model.Phone
                </dd>

                <dt class="col-sm-3">
                    Company
                </dt>

                <dd class="col-sm-9">
                    @Model.Company
                </dd>

                <dt class="col-sm-3">
                    Address
                </dt>

                <dd class="col-sm-9">
                    @Model.Address
                </dd>

                <dt class="col-sm-3">
                    City
                </dt>

                <dd class="col-sm-9">
                    @Model.City
                </dd>

                <dt class="col-sm-3">
                    Country
                </dt>

                <dd class="col-sm-9">
                    @Model.Country
                </dd>

                <dt class="col-sm-3">
                    Created
                </dt>

                <dd class="col-sm-9">
                    @Model.CreatedAt.ToLocalTime()
                </dd>

            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

        </div>

    </div>

</div>